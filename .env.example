# Optional. Everything has a safe default; the demo needs no tenant and no credentials.
# PORT must be in 7680-7689.
PORT=7680
# HMLAB_BIND=127.0.0.1   # loopback only unless you set this on purpose

# Real mode (owner-run, optional). Makes the PRIVILEGE scenario send ONE real MCP tools/call to your Privilege gateway door and show
# its real answer. The approval is yours: in the Privilege console open HITL Requests, approve, and PingID asks you on your phone.
# Leave these empty and the lab stays Mock only, with no outbound network at all. Keep this file out of git (it is git-ignored).
# While Real is on, the lab may reach exactly the host in HMLAB_REAL_URL and nothing else; choosing Mock closes it again.
# HMLAB_REAL_URL=https://<your-gateway-host>/<app>/mcp   # https only (http on loopback only); no credentials in the URL
# HMLAB_REAL_AGENT_KEY=                                   # a Privilege agent access key; write-only: never shown, logged or put in a trace
# HMLAB_REAL_TOOL=                                        # the tool your "Require human approval" policy holds
# HMLAB_REAL_ARGS={}                                      # optional JSON object: that tool's arguments
# HMLAB_REAL_ALLOW_HTTP_HOSTS=host.docker.internal   # optional: allow plain http to this ONE host (a gateway published on the Docker host); needs the next line
# HMLAB_REAL_ALLOW_PRIVATE=1                         # optional: the gateway lives on a private address (required for the line above)
# The lab never calls PingID: with tenant MFA on, Privilege itself sends the PingID push when it holds the call.
